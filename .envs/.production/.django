# General
# ------------------------------------------------------------------------------
# DJANGO_READ_DOT_ENV_FILE=True
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret-key
DJANGO_ADMIN_URL=admin-change-me/
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.example.com

# Demo & Abuse Protection
# ------------------------------------------------------------------------------
DEMO_MODE=False
DEMO_DATA_RETENTION_DAYS=7
CAPTCHA_ENABLED=True
RATELIMIT_ENABLE=True

# Security
# ------------------------------------------------------------------------------
DJANGO_SECURE_SSL_REDIRECT=False

# Email
# ------------------------------------------------------------------------------
DJANGO_SERVER_EMAIL=noreply@example.com

# django-allauth
# ------------------------------------------------------------------------------
DJANGO_ACCOUNT_ALLOW_REGISTRATION=True
DJANGO_ACCOUNT_EMAIL_VERIFICATION=mandatory

# Gunicorn
# ------------------------------------------------------------------------------
WEB_CONCURRENCY=4

# Redis
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# Flower
CELERY_FLOWER_USER=change-me
CELERY_FLOWER_PASSWORD=change-me
